# ══════════════════════════════════════════════════════════════════
# YS-SOFTWARE — environment template
# ══════════════════════════════════════════════════════════════════
# Copy to .env for local development or production deployment.
#
# ⚠ PRODUCTION — variables you MUST set (nothing here is secret-safe):
#   APP_KEY ......................... generate: php artisan key:generate
#   DB_PASSWORD ..................... strong, unique
#   ADMIN_PASSWORD .................. bootstrap admin password
#   FRONTEND_URL .................... the real public origin (CORS/Sanctum)
#   SANCTUM_STATEFUL_DOMAINS ........ the real admin-ui origin
#   MAIL_ADMIN_ADDRESS .............. ops inbox for admin notifications
#   TURNSTILE_SITE_KEY/SECRET_KEY ... set TURNSTILE_ENABLED=true
#   AUTH_COOKIE_PARTITIONED=true .... enable (together with Secure)
#
# ⚠ APP_DEBUG must stay FALSE in production — TRUE leaks stack traces
#   and framework internals to any visitor. This file defaults to the
#   PRODUCTION-SAFE values; flip them back to local/true ONLY in a
#   development .env.
#
# Deployment model (Phase 4A): this stack is deliberately DB/file-backed.
#   cache = file (storage volume) · sessions = file (storage volume)
#   queue = database (jobs table). NO Redis is deployed or required.
# ══════════════════════════════════════════════════════════════════

APP_NAME="YS Systems & Software"
APP_ENV=production
APP_KEY=
# WARNING: set to true ONLY for local development over plain HTTP.
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# K-37: daily (P6-02, 14-day retention). Do not use stack here — the
# framework's stack->single chain writes an unbounded laravel.log.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# info in production; use debug only while troubleshooting.
LOG_LEVEL=info

# ──────────────────────────────────────────
# DATABASE — PostgreSQL
# ──────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ys_api
DB_USERNAME=postgres
DB_PASSWORD=

# ──────────────────────────────────────────
# CACHE & SESSIONS — file-backed (no Redis)
# ──────────────────────────────────────────
# Defaults (also the framework defaults) — do not change without a
# concrete need: cache and sessions live in storage/framework/, which
# the docker stack persists on the backend_storage volume.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

# ──────────────────────────────────────────
# QUEUE — database driver (jobs table)
# ──────────────────────────────────────────
# Jobs and failed jobs live in PostgreSQL (jobs / failed_jobs tables)
# and survive restarts; the queue-worker service consumes them.
QUEUE_CONNECTION=database

# ──────────────────────────────────────────
# MAIL
# ──────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ys-systems.com"
MAIL_FROM_NAME="${APP_NAME}"
# Required for admin notifications (contact requests, welcome emails);
# jobs log a warning and skip when blank. Set in production.
MAIL_ADMIN_ADDRESS=

# ──────────────────────────────────────────
# CORS — Frontend URL
# ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────
# SANCTUM
# ──────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Prefix stamped on new tokens. Changing it invalidates every existing
# token (the prefix is part of the stored token hash) — never change
# this in a deployed environment without re-logging-in everyone.
SANCTUM_TOKEN_PREFIX=token_

# ──────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────
BCRYPT_ROUNDS=12
# VULN-14: bearer sessions idle for longer than this (hours) are killed
# (token deleted, 401 SESSION_EXPIRED). Absolute token TTL (8h/30d)
# still applies on top of it.
SESSION_IDLE_TIMEOUT_HOURS=2

# ──────────────────────────────────────────
# AUTH COOKIE — carries the Sanctum bearer token to the admin UI
# ──────────────────────────────────────────
AUTH_COOKIE_NAME=ys_admin_token
# Leave EMPTY for a host-only cookie (the safe default). Set to a shared
# domain ONLY when the admin UI is served from a subdomain of the API
# host — the cookie's Domain must be a suffix of the response host.
AUTH_COOKIE_DOMAIN=
# Cookie requires HTTPS when "true" (defaults to APP_ENV=production).
AUTH_COOKIE_SECURE=
# CHIPS partitioned cookie — set to true in production (only meaningful
# together with a Secure cookie).
AUTH_COOKIE_PARTITIONED=true

# ──────────────────────────────────────────
# BOOTSTRAP ADMIN — set a strong password in .env (never leave blank in prod)
# ──────────────────────────────────────────
ADMIN_NAME="YS Admin"
ADMIN_EMAIL=admin@ys-systems.com
ADMIN_PASSWORD=

# ──────────────────────────────────────────
# STORAGE
# ──────────────────────────────────────────
FILESYSTEM_DISK=local
MEDIA_MAX_FILE_SIZE=10240

# ──────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────
RATE_LIMIT_PUBLIC_API=120
RATE_LIMIT_AUTH_ATTEMPTS=5
# Per-account login limit — protects a single email from credential
# stuffing across many IPs (window is 60s, like the per-IP limit).
RATE_LIMIT_AUTH_PER_EMAIL=10
# VULN-15: rolling window (hours) over which per-email lockouts escalate:
# 1-5 failures -> 60s block, 6-10 -> 5 min, beyond -> 30 min.
AUTH_LOCKOUT_ESCALATION_HOURS=24
# GAP-01: per-IP budget for Turnstile-verified login requests (10/min vs
# the 5/min unverified budget).
RATE_LIMIT_AUTH_ATTEMPTS_CAPTCHA=10
RATE_LIMIT_CONTACT=3
# Per-email contact form limit (1 hour window).
RATE_LIMIT_CONTACT_EMAIL=2
RATE_LIMIT_SEARCH=60
# VULN-27: admin API budget per authenticated user (300/min; not per IP
# — the admin team shares egress NAT).
RATE_LIMIT_ADMIN=300

# ──────────────────────────────────────────
# CAPTCHA — Cloudflare Turnstile (GAP-01) — admin login only
# ──────────────────────────────────────────
# false in development: the login flow is then unchanged (no widget,
# no server-side verification). Set to true in production and register
# a Turnstile site at https://dash.cloudflare.com -> Turnstile.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The site key is public and is inlined into the admin frontend bundle
# at build time (must be present in ys-web/.env when TURNSTILE_ENABLED=true).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ──────────────────────────────────────────
# MONITORING (future)
# ──────────────────────────────────────────
# SENTRY_DSN=
