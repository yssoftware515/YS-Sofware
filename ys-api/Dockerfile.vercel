# Stage 1: Base — FrankenPHP with PHP 8.4
# Official Vercel Laravel guide pattern: FrankenPHP (PHP + Caddy)
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_pgsql zip opcache mbstring

WORKDIR /app

# Stage 2: Dependencies — install Composer packages without running scripts
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

# Copy application code and generate autoloader (post-autoload-dump hooks run here)
COPY . .
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative

# Stage 3: Runtime — minimal image with app + Caddyfile
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY Caddyfile /etc/frankenphp/Caddyfile

# Allow binding to $PORT (Vercel passes PORT env var, defaults to 80)
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy \
    && mkdir -p /app/bootstrap/cache /app/storage/framework/cache /app/storage/framework/sessions /app/storage/framework/views /app/storage/logs \
    && chown -R www-data:www-data /app/bootstrap/cache /app/storage

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

USER www-data

# Build the compiled caches when the container starts, not in the image.
#
# The image cannot bake them: config:cache resolves the environment
# variables, and Vercel injects those (DATABASE_URL, APP_KEY, ...) into the
# running container, not into the image build. Running the command here is
# therefore the only point where both the code and the real environment are
# available - exactly what the Vercel guide means by "do not run the full
# command while building the container image".
#
# Measured on this codebase: the Laravel boot drops from ~13 ms to ~5 ms,
# and every request pays that boot because FrankenPHP runs without worker
# mode (one PHP process per request).
#
# route:cache was checked against this Sanctum version: with the routes
# cached, GET /sanctum/csrf-cookie still answers 204 and the admin login
# still completes, so the dynamic Sanctum registration survives it.
#
# The caches are idempotent and cheap; if any of them failed the container
# still boots, because FrankenPHP is exec'd either way.
CMD ["sh", "-c", "php artisan config:cache --no-interaction || true; php artisan route:cache --no-interaction || true; php artisan event:cache --no-interaction || true; php artisan view:cache --no-interaction || true; exec frankenphp run --config /etc/frankenphp/Caddyfile"]
