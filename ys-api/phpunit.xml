<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV"          value="testing"/>
        <env name="APP_DEBUG"        value="false"/>
        <!-- APP_KEY: generated by `php artisan key:generate` in .env -->
        <!--
            DATABASE_URL is deliberately CLEARED here. The repository root .env
            points at Neon (the production Postgres), and Laravel's
            ConfigurationUrlParser lets DATABASE_URL override every DB_* value.
            Without this line the test suite would run against Neon itself —
            RefreshDatabase would truncate the production schema, and each
            query would cross the Atlantic (~360 ms), making the suite hang.
            Clearing it makes the tests fall back to the DB_* block below and
            use the local `ys_api_test` database (same as CI).
        -->
        <env name="DATABASE_URL"     value=""/>
        <env name="DB_CONNECTION"    value="pgsql"/>
        <env name="DB_DATABASE"      value="ys_api_test"/>
        <env name="CACHE_STORE"      value="array"/>
        <env name="SESSION_DRIVER"   value="file"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER"      value="array"/>
        <env name="BCRYPT_ROUNDS"    value="4"/>
        <env name="REQUIRE_TLS"      value="false"/>
    </php>
</phpunit>
