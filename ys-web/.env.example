# Copy to .env.local for development. Every value here is read somewhere
# in the codebase (see next.config.ts, lib/api/client.ts, lib/seo.ts) — this
# file existing at all was a real gap: previously the only way to discover
# these variables was grep-ing the source.

# Base URL of the ys-api backend. Next.js's CSP headers and next/image's
# allowed remote hosts (next.config.ts) are both derived from this at build
# time — set it correctly per environment, don't hardcode a fallback here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Canonical public URL of this site itself — used for absolute URLs in
# JSON-LD structured data, canonical tags, and sitemap.xml.
NEXT_PUBLIC_APP_URL=https://ys-systems.com

# Search engine site-verification meta tags. Leave blank to omit the tag
# entirely rather than deploying a placeholder value.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# IndexNow protocol key (instant search-engine indexing on publish/update).
NEXT_PUBLIC_INDEXNOW_KEY=

# Surfaced in the admin panel / footer for build traceability — set by CI,
# not meant to be hand-edited per environment.
NEXT_PUBLIC_BUILD_NUMBER=
