# ───────────────────────────────────────────────
# YS Platform – Environment Configuration
# ───────────────────────────────────────────────

# Application
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
# Canonical URL of the site — ONE variable with two roles: Laravel generates
# absolute URLs (emails, storage) from APP_URL, and the frontend build inlines
# it as NEXT_PUBLIC_APP_URL (canonical tags, JSON-LD, sitemap.xml). Staging
# must set its own domain.
APP_URL=https://ys-systems.com
# Laravel app key (32-byte base64). Required by every container — cookie
# signing fails without it. Generate once: `php artisan key:generate`
APP_KEY=

# Frontend
FRONTEND_PORT=3000
NODE_ENV=production
# Public API base for the frontend build (build-time arg, includes /api/v1).
# Production: set to the public API URL, e.g. https://example.com/api/v1
API_URL=http://localhost:8000/api/v1
# Public origin of the frontend site — the CORS allowlist + Sanctum cookie
# auth in the backend are derived from this. Production: https://example.com
FRONTEND_URL=http://localhost:3000
# Cloudflare Turnstile site key — build-time arg for the frontend image
# (G-04). Empty in dev = widget hidden; the backend enforces verification
# only when TURNSTILE_SECRET_KEY is set (ys-api/.env.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cookie auth over HTTPS requires secure cookies; an external TLS gateway in
# front of the edge nginx does not rewrite them automatically. Fail-closed
# default: true (VULN-09). Local development over plain HTTP must set false.
SESSION_SECURE_COOKIE=true
# Refuse plain-HTTP requests when production (VULN-09 hard gate).
REQUIRE_TLS=true

# Backend
BACKEND_PORT=8000
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=ys_platform
# Application role — least privilege, NEVER the cluster superuser (VULN-08).
# Provisioned on first boot by docker/postgres/init (must not contain ').
DB_USERNAME=ys_app
DB_PASSWORD=
# Cluster superuser — migrations/bootstrap/ops only.
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=

# Bootstrap super admin (set a strong password; seeder fails closed when blank)
ADMIN_NAME=YS Admin
ADMIN_EMAIL=admin@ys-systems.com
ADMIN_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ys-systems.com
# Recipient of queued admin notifications (contact requests, welcome emails) —
# REQUIRED in production; jobs skip with a warning when blank.
MAIL_ADMIN_ADDRESS=

# Nginx
NGINX_PORT=80
# (443 is not published: the edge nginx terminates no TLS; TLS is expected
# on an external gateway in front of it — see deployment docs.)

# Monitoring
GRAFANA_PORT=3001
# Fail-fast in the production profile (no default 'admin' password)
GRAFANA_PASSWORD=

# Database backups (one-shot compose service — profile-controlled, so the
# production profile must be passed: `docker compose --profile production run --rm backup`)
# Backups land in ./backups (host bind mount, gitignored).
# Number of newest dumps to keep (0 = keep all). Timestamped filenames —
# an existing dump is never overwritten, only pruned by count.
BACKUP_RETENTION=7

# Docker build
DOCKER_TARGET=runner
