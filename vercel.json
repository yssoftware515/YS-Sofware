{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "frontend": {
      "root": "ys-web",
      "framework": "nextjs"
    },
    "backend": {
      "root": "ys-api",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/sanctum/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "images": {
    "localPatterns": [
      { "pathname": "/branding/**", "search": "" }
    ],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 604800
  }
}
