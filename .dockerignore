# Root .dockerignore — used when build context is the repo root
# (Render Web Service, and updated Docker Compose backend service).
# Only ys-api/ is needed for the backend Docker build.
*
!ys-api/
# Exclude host vendor/ — the deps stage builds a clean production-only
# vendor/. Including the host vendor/ overwrites it with dev packages
# (Sail, Faker, etc.) causing package:discover failures.
ys-api/vendor/
# Exclude development-only artifacts not needed in the production image.
# (ys-api/.dockerignore also lists these, but is NOT consulted when
# the build context is the repo root.)
ys-api/.git
ys-api/tests
ys-api/phpunit.xml
ys-api/node_modules
# Exclude secrets — .env files contain APP_KEY, DB_PASSWORD, etc.
**/.env
**/.env.*
